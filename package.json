{
  "name": "healthbridge",
  "version": "0.0.0",
  "private": true,
  "description": "HealthKit to personal AI agents, on your own infrastructure.",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "npm run dev --workspace server",
    "typecheck": "npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "build": "npm run build --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
