{
  "name": "@healthbridge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.32.0",
    "zod": "^4.6.6"
  }
}
