{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "healthbridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthbridge",
      "database_id": "f6c80be3-4027-400c-a6a8-e21e7268a567",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": false,
  },
  "secrets": {
    "required": ["INGEST_TOKEN", "MCP_TOKEN"],
  },
}
